rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default.
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidPlayerProfile(data, userId) {
      return data.keys().hasAll(['uid', 'username', 'unlockedLevel', 'totalCompleted', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'username', 'unlockedLevel', 'totalCompleted', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == userId
        && data.username is string && data.username.size() >= 1 && data.username.size() <= 32
        && data.unlockedLevel is int && data.unlockedLevel >= 1 && data.unlockedLevel <= 50
        && data.totalCompleted is int && data.totalCompleted >= 0 && data.totalCompleted <= 50
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLevelProgress(data, userId, levelKey) {
      return data.keys().hasAll(['playerId', 'levelId', 'completed', 'bestMoves', 'completedAt'])
        && data.keys().hasOnly(['playerId', 'levelId', 'completed', 'bestMoves', 'bestTimeMs', 'completedAt'])
        && data.playerId is string && data.playerId.size() >= 1 && data.playerId.size() <= 128 && data.playerId == userId
        && data.levelId is int && data.levelId >= 1 && data.levelId <= 50
        && levelKey == 'level_' + string(data.levelId)
        && data.completed is bool
        && data.bestMoves is int && data.bestMoves >= 1 && data.bestMoves <= 9999
        && (!('bestTimeMs' in data) || (data.bestTimeMs is int && data.bestTimeMs >= 100 && data.bestTimeMs <= 36000000))
        && data.completedAt is timestamp;
    }

    function isValidGameSession(data, userId, sessionId) {
      return data.keys().hasAll(['sessionId', 'playerId', 'levelId', 'status', 'moveCount', 'startedAt'])
        && data.keys().hasOnly(['sessionId', 'playerId', 'levelId', 'status', 'moveCount', 'elapsedMs', 'startedAt', 'completedAt'])
        && data.sessionId is string && data.sessionId.size() >= 1 && data.sessionId.size() <= 128 && data.sessionId == sessionId
        && data.playerId is string && data.playerId.size() >= 1 && data.playerId.size() <= 128 && data.playerId == userId
        && data.levelId is int && data.levelId >= 1 && data.levelId <= 50
        && data.status in ['active', 'completed', 'abandoned']
        && data.moveCount is int && data.moveCount >= 0 && data.moveCount <= 9999
        && (!('elapsedMs' in data) || (data.elapsedMs is int && data.elapsedMs >= 0 && data.elapsedMs <= 36000000))
        && data.startedAt is timestamp
        && (!('completedAt' in data) || data.completedAt is timestamp);
    }

    function isValidLeaderboardEntry(data, entryId) {
      return data.keys().hasAll(['playerId', 'username', 'levelId', 'bestMoves', 'verifiedMoves', 'updatedAt'])
        && data.keys().hasOnly(['playerId', 'username', 'levelId', 'bestMoves', 'bestTimeMs', 'verifiedMoves', 'updatedAt'])
        && data.playerId is string && data.playerId.size() >= 1 && data.playerId.size() <= 128 && data.playerId == request.auth.uid
        && data.username is string && data.username.size() >= 1 && data.username.size() <= 32
        && data.levelId is int && data.levelId >= 1 && data.levelId <= 50
        && entryId == string(data.levelId) + '_' + request.auth.uid
        && data.bestMoves is int && data.bestMoves >= 1 && data.bestMoves <= 2000
        && (!('bestTimeMs' in data) || (data.bestTimeMs is int && data.bestTimeMs >= 100 && data.bestTimeMs <= 36000000))
        && data.verifiedMoves is string && data.verifiedMoves.size() == data.bestMoves && data.verifiedMoves.size() <= 2000
        && data.verifiedMoves.matches('^[UDLR]+$')
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidPlayerProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidPlayerProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['username', 'unlockedLevel', 'totalCompleted', 'updatedAt']);
      allow delete: if isVerifiedUser() && isValidId(userId) && isOwner(userId);

      match /levels/{levelKey} {
        allow get: if isValidId(userId) && isValidId(levelKey) && isOwner(userId);
        allow list: if isSignedIn() && isOwner(userId) && resource.data.playerId == request.auth.uid;
        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(levelKey)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidLevelProgress(incoming(), userId, levelKey)
          && incoming().completedAt == request.time;
        allow update: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(levelKey)
          && isOwner(userId)
          && isValidLevelProgress(incoming(), userId, levelKey)
          && incoming().playerId == existing().playerId
          && incoming().levelId == existing().levelId
          && incoming().bestMoves <= existing().bestMoves
          && incoming().completedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['bestMoves', 'bestTimeMs', 'completed', 'completedAt']);
        allow delete: if isVerifiedUser() && isValidId(userId) && isValidId(levelKey) && isOwner(userId);
      }

      match /sessions/{sessionId} {
        allow get: if isValidId(userId) && isValidId(sessionId) && isOwner(userId);
        allow list: if isSignedIn() && isOwner(userId) && resource.data.playerId == request.auth.uid;
        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(sessionId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidGameSession(incoming(), userId, sessionId)
          && incoming().status == 'active'
          && incoming().startedAt == request.time;
        allow update: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(sessionId)
          && isOwner(userId)
          && existing().status == 'active'
          && isValidGameSession(incoming(), userId, sessionId)
          && incoming().sessionId == existing().sessionId
          && incoming().playerId == existing().playerId
          && incoming().levelId == existing().levelId
          && incoming().startedAt == existing().startedAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'moveCount', 'elapsedMs', 'completedAt']);
        allow delete: if isVerifiedUser() && isValidId(userId) && isValidId(sessionId) && isOwner(userId);
      }
    }

    match /leaderboard/{entryId} {
      allow get: if isValidId(entryId);
      allow list: if resource.data.levelId is int && resource.data.bestMoves is int && resource.data.bestMoves >= 1;
      allow create: if isVerifiedUser()
        && isValidId(entryId)
        && isValidLeaderboardEntry(incoming(), entryId)
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(entryId)
        && isValidLeaderboardEntry(incoming(), entryId)
        && existing().playerId == request.auth.uid
        && incoming().playerId == existing().playerId
        && incoming().levelId == existing().levelId
        && incoming().bestMoves <= existing().bestMoves
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['username', 'bestMoves', 'bestTimeMs', 'verifiedMoves', 'updatedAt']);
      allow delete: if isVerifiedUser() && isValidId(entryId) && existing().playerId == request.auth.uid;
    }
  }
}
